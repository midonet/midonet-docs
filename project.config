[access]
	inheritFrom = All-Projects
[access "refs/*"]
	owner = group user/Abel Boldú (abelboldu)
	owner = group user/JF Joly (jfjoly)
	owner = group user/Samir Ibradžić (sibradzic)
	exclusiveGroupPermissions = create
	create = group midonet
[access "refs/for/refs/*"]
	read = group Anonymous Users
	push = group Anonymous Users
	label-Code-Review = -2..+2 group midonet
	label-Code-Review = -1..+1 group Anonymous Users
	label-Verified = -1..+1 group Anonymous Users
	rebase = group midonet
	removeReviewer = group midonet
	submit = group midonet
	exclusiveGroupPermissions = pushMerge label-Code-Review rebase removeReviewer submit
	pushMerge = group midonet
[access "refs/heads/*"]
	read = group Anonymous Users
	exclusiveGroupPermissions = forgeAuthor forgeCommitter label-Code-Review
	forgeAuthor = group midonet
	forgeCommitter = group midonet
	label-Code-Review = -2..+2 group midonet
	label-Code-Review = -1..-1 group Anonymous Users
[access "refs/tags/*"]
	push = +force group midonet
	pushTag = group midonet
	pushSignedTag = group midonet
	exclusiveGroupPermissions = push pushTag pushSignedTag
	read = group Anonymous Users
[receive]
	requireSignedOffBy = true
	requireChangeId = true
	createNewChangeForAllNotInTarget = true
