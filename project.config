[access]
	inheritFrom = All-Projects
[access "refs/*"]
	owner = group midonet-admins
	owner = group user/Jan Hilberath (yantarou)
[access "refs/heads/*"]
	read = group Anonymous Users
	exclusiveGroupPermissions = create forgeCommitter push pushMerge label-Code-Review label-Verified labelAs-Verified removeReviewer submit
	forgeCommitter = group midonet-docs
	label-Code-Review = -2..+2 group midonet-docs
	label-Code-Review = -1..+1 group Registered Users
	label-Verified = -1..+1 group midonet-bots
	label-Verified = -1..+1 group midonet-docs
	submit = group midonet-docs
	push = +force group midonet-docs
	pushMerge = group midonet-docs
	labelAs-Verified = -1..+1 group midonet-docs
	removeReviewer = group midonet-docs
	create = group midonet-docs
[access "refs/tags/*"]
	pushTag = +force group midonet-docs
	pushSignedTag = group midonet-docs
	exclusiveGroupPermissions = pushTag pushSignedTag
	read = group Anonymous Users
[receive]
	requireSignedOffBy = false
	requireChangeId = true
	createNewChangeForAllNotInTarget = false
[access "refs/drafts/*"]
	read = group Anonymous Users
	push = group Registered Users
[access "refs/publish/*"]
	read = group Anonymous Users
	push = group Registered Users
